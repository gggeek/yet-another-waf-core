# @todo listen on 2 unix sockets, one for the proxy and one for the server

# add server-side port and http `Host` header to the access log, to help with troubleshooting
log_format extended '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" $server_port "$http_host"';

server {

    listen 80 default_server;
    listen [::]:80 default_server;

    access_log /var/log/nginx/access.log extended;

    root {{TESTS_ROOT_DIR}}/tests/public;

    index index.php;

    location / {
            # First attempt to serve request as file, then
            # as directory, then fall back to displaying a 404.
            try_files $uri $uri/ =404;
    }

    # pass PHP scripts to FastCGI server
    # NB: the stock php-fpm config for apache also serves .phar and .phtml files. And it prevents files named `.php`
    #     We replicate it here
    location ~ [^/]+\.ph(?:p|ar|html)$ {
           include snippets/fastcgi-php.conf;

           # With php-fpm (or other unix sockets):
           fastcgi_pass {{PHP_FPM_SOCKET}};
           # With php-cgi (or other tcp sockets):
           #fastcgi_pass 127.0.0.1:9000;
    }

    # deny access to .htaccess files, if Apache's document root
    # concurs with nginx's one
    #
    location ~ /\.ht {
           deny all;
    }
}

